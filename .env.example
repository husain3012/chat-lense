POSTGRES_USER=chatlens
# Change this for any installation beyond a private local machine.
POSTGRES_PASSWORD=chatlens
POSTGRES_DB=chatlens
MAX_UPLOAD_MB=100
MAX_EXPANDED_MB=500
SESSION_GAP_HOURS=4
# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

# Optional Gemini synthesis. Never use a NEXT_PUBLIC_ prefix for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_INTERVAL_SECONDS=2
GEMINI_MAX_RETRIES=8
# Conservative UTF-8 byte budget; reserves room for instructions.
GEMINI_INPUT_BUDGET=240000
GEMINI_OUTPUT_TOKENS=8192
GEMINI_CHUNK_MESSAGES=2000
