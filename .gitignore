uploads/
tmp/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal
*.log

# Local implementation notes and machine-specific verification records
REPORT_UPDATES.md
REQUEST_AUDIT.md
VERIFICATION.md

# Editor and operating-system files
.DS_Store
.idea/
.vscode/
